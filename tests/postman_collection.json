{
  "info": { "name": "Task API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "item": [
    {
      "name": "GET /api/tasks",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));"
      ]}}]
    },
    {
      "name": "POST /api/tasks",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"title\": \"Pipeline test task\"}" },
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));",
        "pm.test('Has id', () => pm.expect(pm.response.json()).to.have.property('id'));"
      ]}}]
    }
  ]
}